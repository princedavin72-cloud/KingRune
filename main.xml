<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KingRune Menu"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Switch
            android:id="@+id/highQualitySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enhanced graphics"
            android:textSize="18sp"
            android:padding="12dp" />

        <Switch
            android:id="@+id/effectsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Extra visual effects"
            android:textSize="18sp"
            android:padding="12dp" />

        <Switch
            android:id="@+id/developerSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Developer mode"
            android:textSize="18sp"
            android:padding="12dp" />

        <Button
            android:id="@+id/applyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Apply settings" />

    </LinearLayout>
</ScrollView>

